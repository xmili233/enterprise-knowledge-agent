      "css": ".ds-search{width:190px;height:32px;border:0;border-bottom:1px solid #bcbcbc;background:#fff;color:#333;font-size:12px}.ds-search::placeholder{color:#737373}.ds-search:focus-visible{outline:2px solid #666;outline-offset:4px}"
    },
