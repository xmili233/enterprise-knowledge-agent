      "css": ".ds-tabs{display:flex;gap:32px;border-bottom:1px solid #d7d7d7}.ds-tabs button{font-size:13px;color:#737373;border:0;background:none;padding:0 0 13px;height:43px;cursor:pointer}.ds-tabs button[aria-current]{color:#202020;border-bottom:2px solid #202020;font-weight:600}.ds-tabs button:hover{color:#202020}.ds-tabs button:focus-visible{outline:2px solid #666;outline-offset:3px}"
    },
