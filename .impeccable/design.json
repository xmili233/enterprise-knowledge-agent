      "css": ".ds-composer{background:#fff;border:1px solid #e5e5e5;border-radius:28px;padding:17px 14px 12px 20px;max-width:760px}.ds-composer:focus-within{border-color:#929292}.ds-composer textarea{display:block;width:100%;resize:none;border:0;min-height:84px;font:16px/26px sans-serif;outline:0}.ds-composer textarea::placeholder{color:#737373}.ds-composer span{display:block;margin-top:10px;font-size:12px;color:#555}"
