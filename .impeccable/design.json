      "css": ".ds-cite{border:0;border-radius:5px;background:#eee;color:#555;min-width:20px;height:20px;font-size:10px;cursor:pointer}.ds-cite:hover{background:#d8d8d8;color:#111}.ds-cite:focus-visible{outline:2px solid #666;outline-offset:3px}"
    },
